{"commands":[
{"command":"parameters.add","params":{"name":"ply","expression":"3 mm","comment":"the ply: one lamination"}},
{"command":"parameters.add","params":{"name":"laminations","expression":"1","unit":"","comment":"discs glued face to face: the design's thickness is laminations × ply"}},
{"command":"parameters.add","params":{"name":"teeth","expression":"34","unit":"","comment":"teeth round the rim"}},
{"command":"parameters.add","params":{"name":"tip_d","expression":"159.5 mm","comment":"across the tips"}},
{"command":"parameters.add","params":{"name":"root_d","expression":"138.2 mm","comment":"across the roots"}},
{"command":"parameters.add","params":{"name":"flank","expression":"0.22","unit":"","comment":"each flank's share of a tooth's pitch; the tip has the rest"}},
{"command":"parameters.add","params":{"name":"hole_d","expression":"5 mm","comment":"a cord hole"}},
{"command":"parameters.add","params":{"name":"hole_gap","expression":"30 mm","comment":"cord hole centre to centre"}},
{"command":"parameters.add","params":{"name":"thick","expression":"laminations*ply","comment":"read only: the disc's thickness"}},
{"command":"sketch.create","params":{"plane":"XY","name":"buzz disc sawtooth disc sketch"}},
{"command":"parameters.add","params":{"name":"pitch","expression":"360 deg/teeth","unit":"deg","comment":"read only: one tooth's angle"}},
{"command":"parameters.add","params":{"name":"fa","expression":"flank*pitch","unit":"deg","comment":"read only: one flank's angle"}},
{"command":"sketch.circle.center","params":{"center":["0 mm","0 mm"],"diameter":"root_d"}},
{"command":"sketch.circle.center","params":{"center":["-hole_gap/2","0 mm"],"diameter":"hole_d"}},
{"command":"sketch.circle.center","params":{"center":["hole_gap/2","0 mm"],"diameter":"hole_d"}},
{"command":"sketch.finish","params":{}},
{"command":"solid.extrude","params":{"sketch":"buzz disc sawtooth disc sketch","distance":"thick","operation":"new","name":"buzz disc sawtooth disc","body_name":"buzz disc sawtooth disc"}},
{"command":"sketch.create","params":{"plane":"XY","name":"buzz disc sawtooth disc tooth sketch"}},
{"command":"sketch.arc.center_point","params":{"center":["0 mm","0 mm"],"start":["root_d/2","0 mm"],"end":["root_d/2*cos(pitch)","root_d/2*sin(pitch)"]}},
{"command":"sketch.equation_curve","params":{"x":"(root_d/2 + (tip_d - root_d)/2*t)*cos(t*fa)","y":"(root_d/2 + (tip_d - root_d)/2*t)*sin(t*fa)","start":"0","end":"1","tolerance":0.001}},
{"command":"sketch.arc.center_point","params":{"center":["0 mm","0 mm"],"start":["tip_d/2*cos(fa)","tip_d/2*sin(fa)"],"end":["tip_d/2*cos(pitch - fa)","tip_d/2*sin(pitch - fa)"]}},
{"command":"sketch.equation_curve","params":{"x":"(tip_d/2 - (tip_d - root_d)/2*t)*cos(pitch - fa + t*fa)","y":"(tip_d/2 - (tip_d - root_d)/2*t)*sin(pitch - fa + t*fa)","start":"0","end":"1","tolerance":0.001}},
{"command":"sketch.finish","params":{}},
{"command":"solid.extrude","params":{"sketch":"buzz disc sawtooth disc tooth sketch","distance":"thick","operation":"join","targets":["buzz disc sawtooth disc"],"name":"buzz disc sawtooth disc tooth"}},
{"command":"solid.pattern.circular","params":{"features":["buzz disc sawtooth disc tooth"],"axis":"Z","count":"teeth","name":"buzz disc sawtooth disc tooth pattern"}},
{"command":"inspect.measure","params":{}}
]}
