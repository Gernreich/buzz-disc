# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# The cut files and the SolidCraft designs are drawn by buzz_disc.rs; the
# 3D viewer is built from the cut files by viewer.rs (Rust; repro-svg
# builds it), which reads them with lasermade-tools' turn3d module, so it
# expects that checkout beside this one.

# --- the cut files, drawn by buzz_disc.rs from each disc's parameters (by
# hand in Inkscape until 2026-11-08). The previews and the viewer are built
# from them. ---
BuzzDisc1.svg :: target/release/buzz_disc --disc=sawtooth-disc --out=$(dirname $OUT)
BuzzDisc2.svg :: target/release/buzz_disc --disc=plain-bar --out=$(dirname $OUT)

# --- the previews: display renderings of the cut files ---
previews/BuzzDisc1.svg :: ../lasermade-tools/target/release/make-preview BuzzDisc1.svg $OUT
previews/BuzzDisc2.svg :: ../lasermade-tools/target/release/make-preview BuzzDisc2.svg $OUT

# --- the pages ---
index.html :: ../lasermade-tools/target/release/md2html index.md $OUT
buzz-disc-3d.html :: target/release/viewer --out=$OUT

# --- the SolidCraft designs: each disc as a parametric solid, written by
# buzz_disc.rs, and saved by SolidCraft with the build cache left out
# (lasermade-tools' sc-slim) so the file is the same every time ---
solidcraft/buzz-disc-sawtooth-disc.solidcraft.json :: target/release/buzz_disc --disc=sawtooth-disc --no-write --solidcraft=$(dirname $OUT)
solidcraft/buzz-disc-plain-bar.solidcraft.json :: target/release/buzz_disc --disc=plain-bar --no-write --solidcraft=$(dirname $OUT)
solidcraft/buzz-disc-sawtooth-disc.sc :: target/release/buzz_disc --disc=sawtooth-disc --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/buzz-disc-sawtooth-disc.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
solidcraft/buzz-disc-plain-bar.sc :: target/release/buzz_disc --disc=plain-bar --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/buzz-disc-plain-bar.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT

# --- the STEP files, written by SolidCraft (solidcraft-cli, on PATH) from
# those designs (by step-export from the 3D view until 2026-11-08) ---
step/buzz-disc-sawtooth-disc.step :: target/release/buzz_disc --disc=sawtooth-disc --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/buzz-disc-sawtooth-disc.solidcraft.json --out $OUT --quiet
step/buzz-disc-plain-bar.step :: target/release/buzz_disc --disc=plain-bar --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/buzz-disc-plain-bar.solidcraft.json --out $OUT --quiet
